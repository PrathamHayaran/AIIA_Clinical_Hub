generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(uuid())
  uniqueId     String?        @unique // e.g. AIIA-RES-7821, AIIA-ADM-1001, AIIA-SAF-4091
  email        String         @unique
  password     String
  name         String
  role         String         // ADMIN, RESEARCHER, SAFETY_OFFICER, COMPLIANCE_OFFICER, MANAGEMENT
  department   String         @default("Clinical Research")
  avatar       String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  trials       Trial[]        @relation("CreatedTrials")
  notifications Notification[]
}

model Trial {
  id                    String              @id @default(uuid())
  trialId               String              @unique // e.g. AYU-001
  title                 String
  shortDescription      String
  treatment             String              // e.g. Ashwagandha Extract WS-35
  ayurvedicDiscipline   String              // e.g. Kayachikitsa, Dravyaguna, Panchakarma, Shalya Tantra
  indication            String              // e.g. Generalized Anxiety Disorder, Knee Osteoarthritis
  phase                 String              // Phase I, Phase II, Phase III, Phase IV, Observational
  studyType             String              // Randomized Double-Blind Placebo-Controlled, Open-label, etc.
  principalInvestigator String
  targetParticipants   Int                 @default(100)
  currentEnrolled       Int                 @default(0)
  completedParticipants Int                 @default(0)
  droppedParticipants   Int                 @default(0)
  startDate             DateTime
  expectedEndDate       DateTime
  actualEndDate         DateTime?
  status                String              // Active, Recruiting, Completed, Delayed, Suspended
  riskScore             Int                 @default(15) // 0 - 100
  riskCategory          String              @default("Low") // Low, Medium, High, Critical
  complianceScore       Int                 @default(90) // 0 - 100
  dataQualityScore      Int                 @default(95) // 0 - 100
  safetyScore           Int                 @default(98) // 0 - 100
  createdById           String?
  createdBy             User?               @relation("CreatedTrials", fields: [createdById], references: [id])
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  milestones            TrialMilestone[]
  trialSites            TrialSite[]
  patients              Patient[]
  recruitmentRecords    RecruitmentRecord[]
  safetyEvents          SafetyEvent[]
  complianceRecords     ComplianceRecord[]
  ethicsApproval        EthicsApproval?
  ctriRegistration      CTRIRegistration?
  alerts                Alert[]
  aiAnalyses            AIAnalysis[]
}

model TrialMilestone {
  id            String    @id @default(uuid())
  trialId       String
  trial         Trial     @relation(fields: [trialId], references: [id], onDelete: Cascade)
  title         String    // Protocol Approval, IEC Clearance, CTRI Registration, Site Initiation, First Patient In, 50% Enrollment, Last Patient Out, Database Lock, Final Report
  stage         String    // Protocol, Ethics Approval, CTRI Registration, Site Activation, Patient Recruitment, Treatment, Data Collection, Analysis, Closeout
  sequence      Int       @default(1)
  status        String    @default("PENDING") // COMPLETED, ACTIVE, PENDING, DELAYED
  plannedDate   DateTime
  completedDate DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model ResearchSite {
  id                    String       @id @default(uuid())
  siteCode              String       @unique // e.g. SITE-DEL-01
  name                  String       // All India Institute of Ayurveda, New Delhi
  city                  String
  state                 String
  principalInvestigator String
  contactEmail          String
  contactPhone          String
  capacity              Int          @default(200)
  performanceScore      Int          @default(85)
  recruitmentRate       Int          @default(80)
  dataQualityRate       Int          @default(92)
  complianceRate        Int          @default(95)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  trialSites            TrialSite[]
  patients              Patient[]
  recruitmentRecords    RecruitmentRecord[]
}

model TrialSite {
  id                String       @id @default(uuid())
  trialId           String
  trial             Trial        @relation(fields: [trialId], references: [id], onDelete: Cascade)
  siteId            String
  site              ResearchSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  targetEnrollment  Int          @default(50)
  currentEnrollment Int          @default(0)
  sitePi            String
  status            String       @default("Active") // Active, Pending, Closed
  activationDate    DateTime     @default(now())

  @@unique([trialId, siteId])
}

model Patient {
  id                 String       @id @default(uuid())
  syntheticPatientId String       @unique // e.g. SYNTH-DEL-1001
  trialId            String
  trial              Trial        @relation(fields: [trialId], references: [id], onDelete: Cascade)
  siteId             String
  site               ResearchSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  age                Int
  gender             String       // Male, Female, Other
  doshaPrakriti      String       // Vata, Pitta, Kapha, Vata-Pitta, Pitta-Kapha, Vata-Kapha, Tridoshic
  enrollmentDate     DateTime     @default(now())
  status             String       @default("Enrolled") // Screened, Enrolled, On-Treatment, Follow-Up, Completed, Dropped
  hasAdverseEvent    Boolean      @default(false)
  dataCompleteness   Int          @default(100)
  createdAt          DateTime     @default(now())
}

model RecruitmentRecord {
  id             String       @id @default(uuid())
  trialId        String
  trial          Trial        @relation(fields: [trialId], references: [id], onDelete: Cascade)
  siteId         String
  site           ResearchSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  monthYear      String       // e.g. "2025-01"
  plannedCount   Int          @default(0)
  actualCount    Int          @default(0)
  targetVelocity Float        @default(1.0)
  recordedAt     DateTime     @default(now())
}

model SafetyEvent {
  id                   String    @id @default(uuid())
  eventCode            String    @unique // e.g. SAE-2025-001
  trialId              String
  trial                Trial     @relation(fields: [trialId], references: [id], onDelete: Cascade)
  syntheticPatientId   String?
  eventType            String    // Mild Gastric Upset, Skin Rash, Elevated ALT/AST, Headache, Nausea, Dizziness, Allergic Reaction
  severity             String    // Mild, Moderate, Severe, Serious
  description          String
  onsetDate            DateTime
  reportedDate         DateTime  @default(now())
  status               String    @default("Under Review") // Under Review, Investigating, Resolved, Escalated
  outcome              String?   // Recovered, Resolving, Ongoing, Recovered with Sequelae
  causalityAssessment  String?   // Probable, Possible, Unlikely, Not Related
  reporterName         String
  correctiveAction     String?
  resolutionDate       DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model ComplianceRecord {
  id            String    @id @default(uuid())
  trialId       String
  trial         Trial     @relation(fields: [trialId], references: [id], onDelete: Cascade)
  type          String    // CTRI, Ethics, GCP, Safety_Reporting, Data_Validation
  itemTitle     String
  status        String    // Compliant, Pending_Action, Non_Compliant, Under_Review
  dueDate       DateTime
  completedDate DateTime?
  score         Int       @default(100)
  notes         String?
  verifiedBy    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model EthicsApproval {
  id               String    @id @default(uuid())
  trialId          String    @unique
  trial            Trial     @relation(fields: [trialId], references: [id], onDelete: Cascade)
  committeeName    String    // AIIA Institutional Ethics Committee (IEC-AIIA)
  protocolNumber   String
  approvalDate     DateTime
  expiryDate       DateTime
  status           String    // Approved, Expiring_Soon, Expired, Renewal_Submitted
  renewalRequested Boolean   @default(false)
  renewalDate      DateTime?
  documentRef      String    @default("IEC/AIIA/2024/PROT-089")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model CTRIRegistration {
  id               String    @id @default(uuid())
  trialId          String    @unique
  trial            Trial     @relation(fields: [trialId], references: [id], onDelete: Cascade)
  ctriNumber       String    // e.g. CTRI/2024/09/072412
  registrationDate DateTime
  lastUpdatedDate  DateTime
  nextUpdateDue    DateTime
  status           String    // Registered, Update_Due, Compliant, Under_Review
  url              String    @default("https://ctri.nic.in")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Alert {
  id         String    @id @default(uuid())
  trialId    String?
  trial      Trial?    @relation(fields: [trialId], references: [id], onDelete: SetNull)
  type       String    // Recruitment, Ethics, CTRI, Safety, Data_Quality, Milestone
  severity   String    // High, Warning, Attention, Info
  message    String
  details    String?
  isResolved Boolean   @default(false)
  resolvedAt DateTime?
  resolvedBy String?
  createdAt  DateTime  @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("info") // danger, warning, success, info
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

model AIAnalysis {
  id              String   @id @default(uuid())
  trialId         String
  trial           Trial    @relation(fields: [trialId], references: [id], onDelete: Cascade)
  prompt          String
  analysisType    String   // Risk_Diagnosis, Safety_Audit, Recruitment_Optimization, Comprehensive_Summary
  riskScore       Int      @default(0)
  summary         String
  details         String   // JSON string of structured reasoning
  recommendations String   // JSON string array of recommended actions
  generatedAt     DateTime @default(now())
}
